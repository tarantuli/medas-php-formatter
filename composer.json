{
    "name": "morphp/medas-php-formatter",
    "description": "Medas PHP formatter",
    "authors": [
        {
            "name": "Patrick Morpey",
            "email": "patrick@morphp.nl"
        }
    ],
    "type": "library",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "morphp/medas-service-manager": "dev-dev",
        "morphp/medas-php-tokenizer": "dev-dev",
        "morphp/medas-php-class-analysis": "dev-dev",
        "morphp/medas-file-system": "dev-dev"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5",
        "morphp/medas-config-manager": "dev-dev",
        "morphp/medas-config-options": "dev-dev",
        "morphp/medas-console-printer": "dev-dev"
    },
    "autoload": {
        "psr-4": {
            "Medas\\PhpFormatter\\": "src/",
            "Medas\\Test\\": "tests/"
        }
    }
}
