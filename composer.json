{
  "name": "morphp/medas-php-formatter",
  "description": "Medas PHP formatter",
  "version": "1.0.0",
  "keywords": [
    "backend"
  ],
  "authors": [
    {
      "name": "Patrick Morpey",
      "email": "patrick@morphp.nl"
    }
  ],
  "type": "library",
  "require": {
    "morphp/medas-console": "^1",
    "morphp/medas-core": "^1",
    "morphp/medas-file-system": "^1",
    "morphp/medas-php-class-analysis": "^1",
    "morphp/medas-php-tokenizer": "^1",
    "php": "^8.2"
  },
  "require-dev": {
    "morphp/medas-config-manager": "^1",
    "morphp/medas-config-options": "^1",
    "morphp/medas-console-printer": "^1",
    "morphp/medas-service-manager": "^1",
    "phpunit/phpunit": "^9.5"
  },
  "autoload": {
    "psr-4": {
      "Medas\\PhpFormatter\\": "src/",
      "Medas\\PhpFormatterTest\\": "tests/"
    }
