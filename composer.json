{
  "name": "morphp/medas-php-formatter",
  "description": "Medas PHP formatter",
  "keywords": [
    "backend"
  ],
  "authors": [
    {
      "name": "Patrick Morpey",
      "email": "patrick@morphp.nl"
    }
  ],
  "type": "library",
  "require": {
    "morphp/medas-console": "^3",
    "morphp/medas-core": "^3",
    "morphp/medas-file-system": "^3",
    "morphp/medas-php-class-analysis": "^3",
    "morphp/medas-php-tokenizer": "^3",
    "php": "^8.4"
  },
  "require-dev": {
    "morphp/medas-config-manager": "^3",
    "morphp/medas-config-options": "^3",
    "morphp/medas-console-printer": "^3",
    "morphp/medas-object-instantiator": "^3",
    "morphp/medas-service-manager": "^3",
    "phpunit/phpunit": "^10"
  },
  "autoload": {
    "psr-4": {
      "Medas\\PhpFormatter\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Medas\\PhpFormatterTest\\": "tests/"
    }
  }
}
